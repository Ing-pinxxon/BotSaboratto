# ============================================================
# VARIABLES DE ENTORNO REQUERIDAS
# Copia este archivo como .env y llena los valores.
# ============================================================

# ── Servidor ──
PORT=3000

# ── Google Gemini ──
GEMINI_API_KEY=tu_api_key_de_google_aistudio
GEMINI_MODEL=gemini-2.5-flash-lite

# ── WhatsApp: Meta Cloud API (opción principal) ──
META_ACCESS_TOKEN=tu_token_de_meta
META_VERIFY_TOKEN=tu_token_de_verificacion
DEFAULT_PHONE_NUMBER_ID=tu_phone_number_id

# ── WhatsApp: Kapso (opción alternativa) ──
KAPSO_API_KEY=tu_api_key_de_kapso

# ── WhatsApp: Zernio (proveedor oficial) ──
# Si ZERNIO_API_KEY está presente, tiene prioridad sobre Meta/Kapso.
# Zernio responde dentro de una conversación existente; el conversationId y el
# accountId se leen automáticamente del webhook entrante.
ZERNIO_API_KEY=sk_tu_api_key_de_zernio
# accountId de respaldo (opcional). Normalmente NO hace falta porque viene en
# el webhook. Solo úsalo si el webhook no lo trae. Ej: account.id del webhook.
# ZERNIO_ACCOUNT_ID=6a94ad1d77555aae0121ebca
# Base URL de la API (por defecto https://zernio.com/api/v1).
ZERNIO_BASE_URL=https://zernio.com/api/v1

# ── Notificaciones ──
# Número al que se reenvían confirmaciones (ej. cocina, equipo)
KITCHEN_NUMBER=573000000000
# Número al que se notifican pagos recibidos
BOLD_NOTIFY_NUMBER=573000000000

# ── Debug (opcional) ──
# DEBUG=true
