# ============================================================
# VARIABLES DE ENTORNO REQUERIDAS
# Copia este archivo como .env y llena los valores.
# ============================================================

# ── Servidor ──
PORT=3000

# ── Google Gemini ──
GEMINI_API_KEY=tu_api_key_de_google_aistudio
GEMINI_MODEL=gemini-2.5-flash-lite

# ── WhatsApp: Meta Cloud API (opción principal) ──
META_ACCESS_TOKEN=tu_token_de_meta
META_VERIFY_TOKEN=tu_token_de_verificacion
DEFAULT_PHONE_NUMBER_ID=tu_phone_number_id

# ── WhatsApp: Kapso (opción alternativa) ──
KAPSO_API_KEY=tu_api_key_de_kapso

# ── Notificaciones ──
# Número de WhatsApp de la cocina al que se envía la comanda al confirmar.
# DEBE ser un número 1:1 (la API de WhatsApp NO envía a grupos NI a sí misma).
# IMPORTANTE: si la cocina usa la MISMA línea donde corre el bot, déjalo
# VACÍO — WhatsApp no permite auto-envío. En ese caso usa Google Sheets como
# tablero de cocina (abajo). Solo llénalo si la cocina tiene un número aparte.
KITCHEN_NUMBER=
# Número al que se notifican pagos recibidos
BOLD_NOTIFY_NUMBER=573000000000

# ── Boucher en la nube: Google Sheets (opcional) ──
# Si se configuran, cada pedido confirmado se agrega como fila a la hoja.
# Si se dejan vacíos, el bot guarda solo en el CSV local (data/pedidos.csv).
# 1) Crea un service account en Google Cloud y habilita "Google Sheets API".
# 2) Comparte tu hoja de cálculo con el email del service account (como Editor).
# 3) El ID de la hoja está en su URL: .../spreadsheets/d/<ESTE_ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-bot@tu-proyecto.iam.gserviceaccount.com
# La clave privada va entre comillas y con \n literales (una sola línea):
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Debug (opcional) ──
# DEBUG=true
