# ============================================================
# VARIABLES DE ENTORNO REQUERIDAS
# Copia este archivo como .env y llena los valores.
# ============================================================

# ── Servidor ──
PORT=3000

# ── Google Gemini ──
GEMINI_API_KEY=tu_api_key_de_google_aistudio
GEMINI_MODEL=gemini-2.5-flash-lite

# ── WhatsApp: Zernio (único proveedor) ──
# Zernio responde dentro de una conversación existente; el conversationId y el
# accountId se leen automáticamente del webhook entrante.
ZERNIO_API_KEY=sk_tu_api_key_de_zernio
# accountId de respaldo (opcional). Normalmente NO hace falta porque viene en
# el webhook. Solo úsalo si el webhook no lo trae. Ej: account.id del webhook.
# ZERNIO_ACCOUNT_ID=6a94ad1d77555aae0121ebca
# Base URL de la API (por defecto https://zernio.com/api/v1).
ZERNIO_BASE_URL=https://zernio.com/api/v1

# ── Menú en imágenes ──
# Dominio público del bot (Railway → Settings → Networking). Se usa para armar
# la URL de las imágenes de public/menu/. Opcional: por defecto es el de abajo.
# PUBLIC_BASE_URL=https://botsaboratto.up.railway.app

# ── Boucher en la nube: Google Sheets ──
# Cada pedido confirmado se agrega como una fila a tu hoja de cálculo.
# Si dejas todo vacío, el bot guarda solo en el CSV local (data/pedidos.csv).
#
# CAMINO RECOMENDADO (fácil, copiar-pegar): Apps Script Web App.
#   1) Crea una hoja en Google Sheets.
#   2) Extensiones → Apps Script, pega el código del README, guarda.
#   3) Implementar → Nueva implementación → "Aplicación web" → acceso
#      "Cualquier usuario" → Implementar, y copia la URL /exec.
#   4) Pega esa URL aquí:
SHEETS_WEBHOOK_URL=
#
# CAMINO AVANZADO (service account de Google Cloud). Solo si prefieres este:
#   1) Crea un service account y habilita "Google Sheets API".
#   2) Comparte la hoja con el email del service account (como Editor).
#   3) El ID de la hoja está en su URL: .../spreadsheets/d/<ESTE_ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-bot@tu-proyecto.iam.gserviceaccount.com
# La clave privada va entre comillas y con \n literales (una sola línea):
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Control manual del bot (pausar/activar por WhatsApp) ──
# Tu WhatsApp personal (y el de quien más quieras autorizar), separados por
# coma. Solo estos números pueden pausar/activar el bot enviándole:
#   "pausar bot"   → el bot deja de responder a los clientes
#   "activar bot"  → el bot vuelve a responder
#   "estado bot"   → el bot te dice si está activo o pausado
# Pon el número con indicativo del país, solo dígitos. Ej: 573001112233
# Si lo dejas vacío, cualquiera que sepa la palabra clave podría controlarlo.
ADMIN_NUMBERS=

# ── Debug (opcional) ──
# DEBUG=true

# ── Pantalla de comandas (opcional) ──
# Si se configuran, los pedidos confirmados aparecen solos en la app de
# comandas, marcados como "sin revisar". La service_role key se copia de
# Supabase > Project Settings > API. Si faltan, el bot funciona igual.
COMANDAS_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
COMANDAS_SERVICE_KEY=
# Clave de integración del negocio: Comandapp → Panel del dueño → Mi negocio
COMANDAS_CLAVE_NEGOCIO=
